        "jsCode": "const aiOutput = JSON.parse($input.item.json.response);\nconst webhookData = $('Webhook').item.json.body;\n\nreturn {\n  json: {\n    ticket_id: 'BUG-' + Date.now(),\n    title: webhookData.title,\n    description: webhookData.description,\n    reporter: webhookData.reporter,\n    module: webhookData.module,\n    severity: aiOutput.severity,\n    category: aiOutput.category,\n    assigned_team: aiOutput.assigned_team,\n    priority_score: aiOutput.priority_score,\n    status: 'Open',\n    timestamp: new Date().toISOString()\n  }\n};"
